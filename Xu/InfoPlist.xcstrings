    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhẩm uses the camera to scan receipts and attach photos to expenses."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhẩm dùng camera để chụp hóa đơn và ảnh cho khoản chi."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhẩm uses Face ID to lock the app and protect your spending data."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhẩm dùng Face ID để khóa app và bảo vệ số liệu chi tiêu của bạn."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhẩm uses the microphone so you can say an expense instead of typing it."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhẩm dùng micro để bạn nói khoản chi thay vì gõ."
          }
        }
      }
    },
